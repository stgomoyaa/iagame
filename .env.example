# Copiar a .env.local y rellenar. .env.local está en .gitignore y nunca se commitea.
#
# Steam Web API. Se saca gratis en https://steamcommunity.com/dev/apikey
# Pide un dominio al registrar: sirve cualquiera que controles (ej. example.com).
# La usa el catalogador del Workshop de GMod (IPublishedFileService/QueryFiles).
# Nunca hardcodear el valor en un script ni pegarlo en un chat: si se expone,
# regenerarla desde esa misma página invalida la anterior al instante.
STEAM_API_KEY=
